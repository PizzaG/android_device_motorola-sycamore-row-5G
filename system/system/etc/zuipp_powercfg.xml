<?xml version="1.0" encoding="utf-8"?>
<PowerConfig version="20231210">

    <!-- 发热先知配置项 -->
    <OverHeat>
        <CommonPolicy>
            <Item name="startCleanTemp">45</Item> <!-- 大于此温度，开始检查进程耗电 -->
            <Item name="cancelCleanTemp">42</Item> <!-- 小于此温度，结束检查进程耗电 -->
            <Item name="timeInterval">300000</Item> <!-- 检查时间间隔，单位：ms -->
        </CommonPolicy>

        <PackagePolicy>
            <!--    type: heat or stub
                    bgTime: running time in background
                    cycle:
                    power:
                    bigPower:-->
            <Package name="default">
                <Item name="type">heat</Item>
                <Item name="bgTime">60</Item>
                <Item name="cycle">1</Item>
                <Item name="power">1</Item>
                <Item name="bigPower">3</Item>
            </Package>
            <Package name="default">
                <Item name="type">stub</Item>
                <Item name="bgTime">1800</Item>
                <Item name="cycle">3</Item>
                <Item name="power">2</Item>
                <Item name="bigPower">30</Item>
            </Package>

