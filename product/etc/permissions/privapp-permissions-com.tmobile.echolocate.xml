        <permission name="com.tmobile.oem.echolocate.system.provider.messagestats.PendingMessagesContentProvider.READ_MMS_SMS_PENDING"/>
        <permission name="com.tmobile.oem.echolocate.system.provider.messagestats.PendingMessagesContentProvider.WRITE_MMS_SMS_PENDING"/>
        <!-- Radio Permissions -->
        <permission name="com.tmobile.oem.echolocate.system.provider.backgroundstats.RadioContentProvider.READ_RADIO_STATS"/>
        <permission name="com.tmobile.oem.echolocate.system.provider.backgroundstats.RadioContentProvider.WRITE_RADIO_STATS"/>
        <!-- Ims Permissions -->
        <permission name="com.tmobile.oem.echolocate.system.provider.backgroundstats.ImsContentProvider.READ_IMS_STATS"/>
        <permission name="com.tmobile.oem.echolocate.system.provider.backgroundstats.ImsContentProvider.WRITE_IMS_STATS"/>
