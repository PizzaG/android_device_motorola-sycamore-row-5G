#add node perms for different plat
#Sycamore code for SYCAMORE-370 by zenghui4 at 2024.11.29 start
on post-fs-data
    chown system system /proc/gesture_control
    chown system system /proc/panel_direction
    chown system system /proc/game_mode
    chown system system /proc/edge_grid_zone
    chown system system /proc/support_pen
    chown system system /proc/Pen_ID
#    chown system system /proc/haptics
#Sycamore code for SYCAMORE-370 by zenghui4 at 2024.11.29 end

service touchscreen_hal_service /vendor/bin/hw/vendor.lenovo.hardware.touchscreen-service
    class hal
    user system
    group system
